# Copy to .env and fill in. .env is private and must never be committed.

# Telegram bot that receives contact form requests (token from @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat (person or group) the bot writes to. After pressing Start in the bot, run:
#   npm run telegram:chat-id
TELEGRAM_CHAT_ID=

# Optional: send the contact form somewhere other than this site's own /api/contact
VITE_CONTACT_ENDPOINT=

# How long an IP stays blocked after 5 junk requests (0 = permanently).
# Mobile operators often share one IP between many customers, so long blocks can hit real clients.
SPAM_BLOCK_DAYS=7

# Yandex Metrika counter number (metrika.yandex.ru → Add counter). Leave empty to turn analytics off.
# This one is public (it ends up in the page), unlike the Telegram token.
VITE_YANDEX_METRIKA_ID=
