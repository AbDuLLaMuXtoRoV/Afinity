# Copy to .env and fill in. .env is private and must never be committed.

# Telegram bot that receives contact form requests (token from @BotFather)
TELEGRAM_BOT_TOKEN=

# Chat (person or group) the bot writes to. After pressing Start in the bot, run:
#   npm run telegram:chat-id
TELEGRAM_CHAT_ID=

# Optional: send the contact form somewhere other than this site's own /api/contact
VITE_CONTACT_ENDPOINT=
